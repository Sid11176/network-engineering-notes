<mxfile host="app.diagrams.net" modified="2026-11-13"><diagram id="s2" name="Session 2 topology"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="900" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style='font-size:16px'&gt;Session 2 topology&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;HQ VLANs, router-on-a-stick and branch static routing · &lt;code&gt;v0-foundation.pkt&lt;/code&gt; · static addressing, no DHCP, NAT or ISP yet&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry" /></mxCell><mxCell id="zHQ" value="HQ" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;strokeColor=#888888;strokeWidth=2;arcSize=2;fillColor=#dae8fc;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="640" height="560" as="geometry" /></mxCell><mxCell id="zBR" value="Branch (new in Session 2)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;strokeColor=#888888;strokeWidth=2;arcSize=2;fillColor=#ffe6cc;opacity=60;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="420" height="560" as="geometry" /></mxCell><mxCell id="R1" value="&lt;b&gt;R1&lt;/b&gt; · Cisco 2911&lt;br&gt;HQ router" style="shape=mxgraph.cisco.routers.router;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=12;verticalLabelPosition=top;verticalAlign=bottom;align=center;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="70" height="45" as="geometry" /></mxCell><mxCell id="SW1" value="&lt;b&gt;SW1&lt;