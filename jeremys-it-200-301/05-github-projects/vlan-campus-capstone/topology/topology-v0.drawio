</mxCell><mxCell id="p6" value="10.0.0.0/30 transit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#ffffff;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="562" y="144" width="130" height="16" as="geometry" /></mxCell><mxCell id="p7" value="Gi0/1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="186" width="40" height="16" as="geometry" /></mxCell><mxCell id="p8" value="Gi0/1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="274" width="40" height="16" as="geometry" /></mxCell><mxCell id="p9" value="192.168.40.0/24 · gw .1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#eeeeee;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="830" y="230" width="170" height="16" as="geometry" /></mxCell><mxCell id="pa0" value="Fa0/1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="257" y="374" width="40" height="16" as="geometry" /></mxCell><mxCell id="pb0" value="Fa0" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="147" y="450" width="30" height="16" as="geometry" /></mxCell><mxCell id="pv0" value="VLAN 10" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#fff2cc;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="187" y="414" width="58" height="16" as="geometry" /></mxCell><mxCell id="pa1" value="Fa0/2" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="315" y="374" width="40" height="16" as="geometry" /></mxCell><mxCell id="pb1" value="Fa0" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="320" y="450" width="30" height="16" as="geometry" /></mxCell><mxCell id="pv1" value="VLAN 20" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#e1d5e7;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="306" y="414" width="58" height="16" as="geometry" /></mxCell><mxCell id="pa2" value="Fa0/3" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="373" y="374" width="40" height="16" as="geometry" /></mxCell><mxCell id="pb2" value="Fa0" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="493" y="450" width="30" height="16" as="geometry" /></mxCell><mxCell id="pv2" value="VLAN 30" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#f8cecc;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="425" y="414" width="58" height="16" as="geometry" /></mxCell><mxCell id="pa9" value="Fa0/1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="895" y="353" width="40" height="16" as="geometry" /></mxCell><mxCell id="pb9" value="Fa0" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#ffffff;rounded=1;strokeColor=#cccccc;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="900" y="447" width="30" height="16" as="geometry" /></mxCell><mxCell id="pv9" value="VLAN 1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fillColor=#eeeeee;rounded=1;strokeColor=#888888;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="886" y="400" width="58" height="16" as="geometry" /></mxCell><mxCell id="roas" value="&lt;b&gt;R1 · router-on-a-stick&lt;/b&gt;&lt;br&gt;Gi0/0: no IP address (trunk parent)&lt;br&gt;Gi0/0.10 · dot1Q 10 · 192.168.10.1/24&lt;br&gt;Gi0/0.20 · dot1Q 20 · 192.168.20.1/24&lt;br&gt;Gi0/0.30 · dot1Q 30 · 192.168.30.1/24" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="230" height="110" as="geometry" /></mxCell><mxCell id="brn" value="&lt;b&gt;R2 · branch gateway&lt;/b&gt;&lt;br&gt;Gi0/1 · 192.168.40.1/24 (LAN)&lt;br&gt;Gi0/0 · 10.0.0.2/30 (transit)" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=11;spacing=8;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="985" y="100" width="145" height="80" as="geometry" /></mxCell><mxCell id="tbl" value="&lt;table style='font-size:11px;border-collapse:collapse;width:100%' cellpadding='3'&gt;&lt;tr&gt;&lt;td colspan='3'&gt;&lt;b&gt;Static routes (AD 1)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Router&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Destination&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&lt;b&gt;Next hop&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R1&lt;/td&gt;&lt;td&gt;192.168.40.0/24&lt;/td&gt;&lt;td&gt;10.0.0.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R2&lt;/td&gt;&lt;td&gt;192.168.10.0/24&lt;/td&gt;&lt;td&gt;10.0.0.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R2&lt;/td&gt;&lt;td&gt;192.168.20.0/24&lt;/td&gt;&lt;td&gt;10.0.0.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R2&lt;/td&gt;&lt;td&gt;192.168.30.0/24&lt;/td&gt;&lt;td&gt;10.0.0.1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="640" width="330" height="150" as="geometry" /></mxCell><mxCell id="ver" value="&lt;b&gt;What Session 2 verified&lt;/b&gt;&lt;br&gt;• HQ PCs in VLANs 10, 20 and 30 reach PC-BRANCH (192.168.40.10)&lt;br&gt;• &lt;code&gt;tracert&lt;/code&gt; from PC-ADMIN: 192.168.10.1 → 10.0.0.2 → 192.168.40.10&lt;br&gt;• One-way route test: removing R2's route to 192.168.20.0/24 makes VLAN 20 pings to the branch fail, because replies have no way back; restoring it fixes them" style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="370" y="640" width="480" height="150" as="geometry" /></mxCell><mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style='color:#1F6FD0'&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/span&gt; 802.1Q trunk&lt;br&gt;&lt;span style='color:#2E9E44'&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/span&gt; access link&lt;br&gt;&lt;span style='color:#333333'&gt;&lt;b&gt;━━━&lt;/b&gt;&lt;/span&gt; routed link&lt;br&gt;PCs are on SW1 with static addresses; the VLAN colours match the pills on each access link." style="rounded=1;arcSize=3;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="640" width="270" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>