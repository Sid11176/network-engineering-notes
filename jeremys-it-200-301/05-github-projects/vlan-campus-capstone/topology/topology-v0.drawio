olor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="312" y="470" width="45" height="40" as="geometry" /></mxCell><mxCell id="PCI" value="&lt;b&gt;PC-IT&lt;/b&gt;&lt;br&gt;VLAN 30&lt;br&gt;192.168.30.10/24&lt;br&gt;gw 192.168.30.1" style="shape=mxgraph.cisco.computers_and_peripherals.pc;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="505" y="470" width="45" height="40" as="geometry" /></mxCell><mxCell id="PCB" value="&lt;b&gt;PC-BRANCH&lt;/b&gt;&lt;br&gt;VLAN 1&lt;br&gt;192.168.40.10/24&lt;br&gt;gw 192.168.40.1" style="shape=mxgraph.cisco.computers_and_peripherals.pc;sketch=0;html=1;pointerEvents=1;dashed=0;fillColor=#036897;strokeColor=#ffffff;strokeWidth=2;outlineConnect=0;fontSize=12;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="892" y="470" width="45" height="40" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1F6FD0;strokeWidth=3.5;" edge="1" parent="1" source="R1" target="SW1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#2E9E44;strokeWidth=2.5;" edge="1" parent="1" source="R2" target="SW4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=3;" edge="1" parent="1" source="R1" target="R2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_PCA" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#2E9E44;strokeWidth=2.5;" edge="1" parent="1" source="SW1" target="PCA"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l_PCU" value="" style="endArrow=n